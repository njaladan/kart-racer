{
  "name": "turbo-trail",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "node src/multiplayer/server.js",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"styles/**/*.css\" \"*.css\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.json\" \"styles/**/*.css\" \"*.css\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "basisu": "1.16.3",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "meshoptimizer": "1.2.0",
    "prettier": "^3.9.9",
    "sharp": "0.35.5",
    "three": "0.180.0"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
